<view class="page profile-page">
  <view class="profile-hero">
    <view class="profile-identity">
      <view class="profile-avatar">
        <van-icon name="manager-o" size="54rpx"></van-icon>
      </view>
      <view class="profile-copy">
        <text class="profile-title">工时清单</text>
      </view>
    </view>
  </view>

  <view class="profile-tabs">
    <button
      wx:for="{{profileTabs}}"
      wx:key="key"
      class="profile-tab {{activeProfileTab === item.key ? 'is-active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="switchProfileTab"
    >
      <van-icon name="{{item.icon}}" size="30rpx"></van-icon>
      <text>{{item.label}}</text>
    </button>
  </view>

  <view class="profile-content">
    <view wx:if="{{activeProfileTab === 'report'}}" class="tool-panel">
      <view class="panel-title-row">
        <view class="card-title">
          <van-icon name="description-o" size="30rpx" color="var(--app-primary)"></van-icon>
          <text>报表导出</text>
        </view>
      </view>

      <view class="range-chips">
        <button class="range-chip" hover-class="chip-pressed" bindtap="useWeekExportRange">本周</button>
        <button class="range-chip" hover-class="chip-pressed" bindtap="useMonthExportRange">本月</button>
        <button class="range-chip" hover-class="chip-pressed" bindtap="useLastMonthExportRange">上月</button>
      </view>

      <view class="range-row">
        <picker mode="date" value="{{exportStart}}" bindchange="onExportStartChange">
          <view class="range-block" hover-class="chip-pressed">
            <text class="range-block-value">{{exportStart}}</text>
          </view>
        </picker>
        <view class="range-arrow">
          <van-icon name="arrow" size="26rpx" color="var(--app-text-soft)"></van-icon>
        </view>
        <picker mode="date" value="{{exportEnd}}" bindchange="onExportEndChange">
          <view class="range-block" hover-class="chip-pressed">
            <text class="range-block-value">{{exportEnd}}</text>
          </view>
        </picker>
      </view>

      <scroll-view class="export-text" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <block wx:if="{{exportLines.length}}">
          <text wx:for="{{exportLines}}" wx:key="*this" class="export-line">{{item}}</text>
        </block>
        <text wx:else class="export-empty">当前范围暂无记录</text>
      </scroll-view>

      <view class="export-actions">
        <van-button custom-class="export-btn" type="primary" plain round icon="orders-o" bind:click="copyExportText">复制全部</van-button>
        <van-button custom-class="export-btn" type="primary" plain round icon="notes-o" bind:click="copyExportDeltaText">仅差额</van-button>
        <van-button custom-class="export-btn" type="primary" round icon="photo-o" bind:click="generateReportImage">生成图片</van-button>
      </view>
    </view>

    <view wx:if="{{activeProfileTab === 'presets'}}" class="tool-panel">
      <view class="panel-title-row">
        <view class="card-title">
          <van-icon name="setting-o" size="30rpx" color="var(--app-primary)"></van-icon>
          <text>班次管理</text>
        </view>
        <van-tag plain round type="primary">{{presets.length}} 个</van-tag>
      </view>

      <scroll-view wx:if="{{presets.length}}" class="preset-list {{presets.length > 4 ? 'is-scroll' : ''}}" scroll-y="{{presets.length > 4}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view
          wx:for="{{presets}}"
          wx:key="id"
          class="preset-row {{isPresetEditorVisible && editingPresetId === item.id ? 'is-editing' : ''}}"
        >
          <view class="preset-row-main">
            <text class="preset-row-time">{{item.start}}-{{item.end}}</text>
            <text class="preset-row-note">{{item.deductBreak ? '扣休0.5h' : '不扣休'}}</text>
          </view>
          <button class="icon-button" hover-class="chip-pressed" data-id="{{item.id}}" bindtap="editPreset">
            <van-icon name="edit" size="32rpx"></van-icon>
          </button>
          <button class="icon-button is-danger" hover-class="chip-pressed" data-id="{{item.id}}" bindtap="deletePreset">
            <van-icon name="delete-o" size="32rpx"></van-icon>
          </button>
        </view>
      </scroll-view>

      <view wx:else class="empty-tip">
        <text>暂无班次，点击下方按钮添加</text>
      </view>

      <van-button
        wx:if="{{!isPresetEditorVisible}}"
        custom-class="full-button"
        block
        round
        plain
        type="primary"
        icon="plus"
        bind:click="startAddPreset"
      >新增班次</van-button>

      <view wx:if="{{isPresetEditorVisible}}" class="preset-editor">
        <text class="editor-title">{{isAddingPreset ? '新增班次' : '编辑班次'}}</text>
        <view class="time-grid">
          <picker mode="multiSelector" range="{{timePickerRange}}" value="{{presetStartTimePickerValue}}" bindchange="onPresetStartChange">
            <view class="time-block" hover-class="chip-pressed">
              <text class="time-block-value">{{presetForm.start}}</text>
            </view>
          </picker>
          <view class="time-arrow">
            <van-icon name="arrow" size="28rpx" color="var(--app-text-soft)"></van-icon>
          </view>
          <picker mode="multiSelector" range="{{timePickerRange}}" value="{{presetEndTimePickerValue}}" bindchange="onPresetEndChange">
            <view class="time-block" hover-class="chip-pressed">
              <text class="time-block-value">{{presetForm.end}}</text>
            </view>
          </picker>
        </view>
        <view class="switch-line">
          <text class="switch-title">扣休0.5h</text>
          <van-switch checked="{{presetForm.deductBreak}}" size="44rpx" bind:change="onPresetBreakChange"></van-switch>
        </view>
        <view class="editor-actions">
          <van-button custom-class="editor-cancel" type="default" plain round bind:click="cancelPresetEdit">取消</van-button>
          <van-button custom-class="editor-save" type="primary" round bind:click="savePreset">保存</van-button>
        </view>
      </view>
    </view>

    <view wx:if="{{activeProfileTab === 'balance'}}" class="tool-panel">
      <view class="panel-title-row">
        <view class="card-title">
          <van-icon name="balance-list-o" size="30rpx" color="var(--app-primary)"></van-icon>
          <text>结余设置</text>
        </view>
      </view>

      <picker class="balance-month-picker" mode="date" fields="month" value="{{balanceMonthKey}}" bindchange="onBalanceMonthChange">
        <view class="month-capsule" hover-class="chip-pressed">
          <van-icon name="calendar-o" size="30rpx" color="var(--app-primary)"></van-icon>
          <text class="month-capsule-text">{{balanceMonthLabel}}</text>
          <van-icon name="arrow-down" size="22rpx" color="var(--app-text-soft)"></van-icon>
        </view>
      </picker>

      <view class="balance-card">
        <text class="balance-card-label">当前月末结余</text>
        <text class="balance-card-value">{{balanceClosingText}}h</text>
      </view>

      <view class="stepper-row">
        <button class="stepper-button" hover-class="chip-pressed" data-step="-0.5" bindtap="stepBalanceInput">
          <van-icon name="minus" size="28rpx"></van-icon>
        </button>
        <input class="stepper-input" type="digit" value="{{balanceInput}}" bindinput="onBalanceInput" />
        <button class="stepper-button" hover-class="chip-pressed" data-step="0.5" bindtap="stepBalanceInput">
          <van-icon name="plus" size="28rpx"></van-icon>
        </button>
      </view>
      <text class="stepper-hint">直接输入或按 0.5h 步进调整目标结余</text>

      <van-button custom-class="full-button" block type="primary" round icon="success" bind:click="saveOpeningBalanceSetting">保存结余</van-button>
    </view>

    <view wx:if="{{activeProfileTab === 'backup'}}" class="tool-panel">
      <view class="panel-title-row">
        <view class="card-title">
          <van-icon name="share-o" size="30rpx" color="var(--app-primary)"></van-icon>
          <text>备份恢复</text>
        </view>
        <van-tag plain round type="primary">{{remoteBackups.length}}/5</van-tag>
      </view>

      <view class="backup-status">
        <view class="backup-status-icon">
          <van-icon name="underway-o" size="36rpx"></van-icon>
        </view>
        <view class="backup-status-copy">
          <text class="backup-status-title">远端备份</text>
          <text class="backup-status-sub">{{remoteBackupStatusText}}</text>
        </view>
        <button class="icon-button" hover-class="chip-pressed" bindtap="loadRemoteBackups">
          <van-icon name="replay" size="30rpx"></van-icon>
        </button>
      </view>

      <view wx:if="{{remoteBackupState === 'conflict'}}" class="remote-conflict">
        <text class="remote-conflict-title">检测到多端数据冲突</text>
        <text class="remote-conflict-desc">{{remoteBackupStatusText}}</text>
        <view class="conflict-actions">
          <van-button size="small" type="danger" round loading="{{isRemoteBackupLoading}}" bind:click="resolveRemoteConflict">解决冲突</van-button>
        </view>
      </view>

      <van-button
        custom-class="full-button"
        block
        type="primary"
        round
        icon="replay"
        loading="{{isRemoteBackupLoading}}"
        bind:click="syncRemoteBackupNow"
      >立即同步</van-button>

      <view wx:if="{{remoteBackups.length}}" class="remote-backup-list">
        <view wx:for="{{remoteBackups}}" wx:key="fileName" class="remote-backup-item">
          <view class="remote-backup-main">
            <text class="remote-backup-time">{{item.createdAtText}}</text>
          </view>
          <van-button size="small" type="primary" plain round data-file="{{item.fileName}}" data-time="{{item.createdAtText}}" bind:click="restoreRemoteBackup">恢复</van-button>
        </view>
      </view>

      <view wx:else class="empty-tip">
        <text>暂无远端备份</text>
      </view>
    </view>
  </view>

  <view class="profile-footer">
    <text class="icp-link">{{icpNumber}}</text>
    <text class="footer-separator">·</text>
    <text>v{{appVersion}}</text>
  </view>

  <canvas type="2d" id="reportCanvas" class="report-canvas" style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"></canvas>
</view>
