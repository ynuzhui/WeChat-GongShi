<view class="page record-page">
  <view class="tool-panel">
    <view class="panel-title-row">
      <view class="card-title">
        <van-icon name="edit" size="30rpx" color="var(--app-primary)"></van-icon>
        <text>填写工时</text>
      </view>
      <van-tag type="{{draftStateTheme}}" plain round size="medium">{{draftStateLabel}}</van-tag>
    </view>

    <view class="date-switch">
      <button class="nav-arrow" hover-class="nav-arrow-active" bindtap="goPrevDay">
        <van-icon name="arrow-left" size="32rpx"></van-icon>
      </button>
      <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
        <view class="date-capsule" hover-class="date-capsule-active">
          <van-icon name="calendar-o" size="30rpx" color="var(--app-primary)"></van-icon>
          <text class="date-main">{{selectedDateLabel}}</text>
        </view>
      </picker>
      <button class="nav-arrow" hover-class="nav-arrow-active" bindtap="goNextDay">
        <van-icon name="arrow" size="32rpx"></van-icon>
      </button>
    </view>

    <view class="segments">
      <button class="segment {{selectedEntry.type === 'work' ? 'is-active' : ''}}" data-type="work" bindtap="onTypeTap">上班</button>
      <button class="segment {{selectedEntry.type === 'rest' ? 'is-active' : ''}}" data-type="rest" bindtap="onTypeTap">本休</button>
      <button class="segment {{selectedEntry.type === 'leave' ? 'is-active' : ''}}" data-type="leave" bindtap="onTypeTap">调休</button>
    </view>
  </view>

  <view wx:if="{{selectedEntry.type === 'work'}}" class="tool-panel">
    <view class="panel-title-row">
      <view class="card-title">
        <van-icon name="apps-o" size="30rpx" color="var(--app-primary)"></van-icon>
        <text>班次</text>
      </view>
    </view>

    <view class="preset-actions">
      <picker
        wx:if="{{presets.length}}"
        class="preset-picker"
        mode="selector"
        range="{{presetOptions}}"
        value="{{selectedPresetIndex}}"
        bindchange="onPresetPickerChange"
      >
        <view class="preset-btn {{selectedEntry.presetId ? 'is-active is-grow' : ''}}" hover-class="chip-pressed">
          <van-icon wx:if="{{!selectedEntry.presetId}}" name="apps-o" size="30rpx"></van-icon>
          <text class="preset-btn-text">{{selectedEntry.presetId ? selectedPresetLabel : '选择班次'}}</text>
        </view>
      </picker>
      <view wx:else class="preset-btn is-disabled">
        <van-icon name="apps-o" size="30rpx"></van-icon>
        <text class="preset-btn-text">暂无班次</text>
      </view>
      <view
        class="preset-btn manual-btn {{isManualEditorVisible ? 'is-active' : ''}} {{selectedEntry.presetId ? 'is-compact' : ''}}"
        hover-class="chip-pressed"
        bindtap="useManualMode"
      >
        <van-icon wx:if="{{!selectedEntry.presetId}}" name="edit" size="30rpx"></van-icon>
        <text class="preset-btn-text">手动填写</text>
      </view>
    </view>
  </view>

  <view wx:if="{{selectedEntry.type === 'work' && isManualEditorVisible}}" class="tool-panel">
    <view class="time-grid">
      <picker mode="multiSelector" range="{{timePickerRange}}" value="{{startTimePickerValue}}" bindchange="onStartChange">
        <view class="time-block" hover-class="chip-pressed">
          <text class="time-block-value">{{selectedEntry.start || '--:--'}}</text>
        </view>
      </picker>
      <view class="time-arrow">
        <van-icon name="arrow" size="28rpx" color="var(--app-text-soft)"></van-icon>
      </view>
      <picker mode="multiSelector" range="{{timePickerRange}}" value="{{endTimePickerValue}}" bindchange="onEndChange">
        <view class="time-block" hover-class="chip-pressed">
          <text class="time-block-value">{{selectedEntry.end || '--:--'}}</text>
        </view>
      </picker>
    </view>

    <view class="switch-line">
      <text class="switch-title">扣休0.5h</text>
      <van-switch checked="{{selectedEntry.deductBreak}}" size="44rpx" bind:change="onDeductBreakChange"></van-switch>
    </view>
  </view>

  <view class="tool-panel">
    <van-field
      custom-class="note-field"
      value="{{selectedEntry.note}}"
      placeholder="备注"
      clearable
      border="{{false}}"
      extra-event-params="{{true}}"
      bind:input="onNoteInput"
    ></van-field>

    <view class="calc-line {{selectedWarning ? 'is-warning' : ''}}">
      <van-icon name="{{selectedWarning ? 'warning-o' : 'passed'}}" size="30rpx" color="{{selectedWarning ? 'var(--app-warning)' : 'var(--app-primary)'}}"></van-icon>
      <text>{{selectedWarning || selectedSummary}}</text>
    </view>

    <view class="record-actions">
      <van-button custom-class="clear-button" type="default" plain round bind:click="clearSelected">清空</van-button>
      <van-button custom-class="save-button" type="primary" round bind:click="saveDraft">保存记录</van-button>
    </view>
  </view>
</view>
