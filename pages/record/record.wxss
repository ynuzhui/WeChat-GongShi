.record-page {
  padding: 20rpx 28rpx 96rpx;
}

.tool-panel {
  margin-bottom: 28rpx;
  padding: 32rpx;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--app-text);
  font-size: 28rpx;
  font-weight: 700;
}

.record-actions,
.switch-line,
.date-switch,
.time-grid {
  display: flex;
  align-items: center;
}

.date-switch,
.switch-line {
  justify-content: space-between;
}

/* ===== 日期导航 ===== */
.date-switch {
  gap: 16rpx;
  margin-top: 24rpx;
}

.date-switch picker {
  flex: 1;
  min-width: 0;
}

.nav-arrow {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--app-radius-sm);
  background: var(--app-card-soft);
  color: var(--app-text-muted);
  transition: all 0.2s;
}

.nav-arrow-active {
  background: var(--app-primary-soft);
  color: var(--app-primary);
  transform: scale(0.92);
}

.date-capsule {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: var(--app-radius-sm);
  background: var(--app-card-soft);
  transition: transform 0.2s;
}

.date-capsule-active {
  transform: scale(0.97);
}

.date-main {
  overflow: hidden;
  max-width: 100%;
  color: var(--app-text);
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 类型分段 ===== */
.segments {
  display: flex;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 8rpx;
  border-radius: var(--app-radius-sm);
  background: var(--app-card-soft);
}

.segment {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0;
  border-radius: 18rpx;
  color: var(--app-text-muted);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1;
  background: transparent;
  transition: all 0.2s;
}

.segment.is-active {
  color: #ffffff;
  background: var(--app-primary);
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx var(--app-primary-glow);
}

/* ===== 班次选择 / 手动填写 ===== */
.preset-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.preset-picker {
  flex: 1;
  min-width: 0;
}

.preset-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  padding: 0 16rpx;
  border-radius: var(--app-radius-sm);
  background: var(--app-card-soft);
  color: var(--app-text-muted);
  transition: all 0.2s;
}

.preset-btn.manual-btn {
  flex: 1;
  min-width: 0;
}

/* 选中班次后：班次按钮占据更多空间以完整显示时间，手动按钮收窄 */
.preset-picker {
  transition: flex 0.2s;
}

.preset-btn.is-grow {
  padding: 0 12rpx;
}

.preset-btn.manual-btn.is-compact {
  flex: 0 0 auto;
  min-width: 0;
  padding: 0 22rpx;
}

.preset-btn.is-active {
  background: var(--app-primary-soft);
  box-shadow: inset 0 0 0 2rpx var(--app-primary);
  color: var(--app-primary);
}

.preset-btn.is-disabled {
  flex: 1;
  min-width: 0;
  color: var(--app-text-soft);
}

.preset-btn-text {
  overflow: hidden;
  max-width: 100%;
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-pressed {
  opacity: 0.8;
  transform: scale(0.97);
}

/* ===== 手动时间块 ===== */
.time-grid {
  gap: 16rpx;
}

.time-grid picker {
  flex: 1;
  min-width: 0;
}

.time-arrow {
  flex: none;
  display: flex;
  align-items: center;
}

.time-block {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: var(--app-radius-sm);
  background: var(--app-card-soft);
  transition: all 0.2s;
}

.time-block-value {
  color: var(--app-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.1;
}

.switch-line {
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--app-radius-sm);
  background: var(--app-card-soft);
}

.switch-title {
  overflow: hidden;
  color: var(--app-text);
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 备注与保存 ===== */
.note-field {
  min-height: 104rpx !important;
  padding: 18rpx 10rpx !important;
  border-radius: var(--app-radius-sm);
  background: var(--app-card-soft) !important;
}

.calc-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  overflow: hidden;
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--app-radius-sm);
  color: var(--app-text);
  background: var(--app-primary-soft);
  font-size: 24rpx;
  line-height: 1.35;
}

.calc-line text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calc-line.is-warning {
  color: var(--app-warning);
  background: var(--app-warning-soft);
}

.record-actions {
  gap: 14rpx;
  margin-top: 22rpx;
}

.record-actions van-button {
  display: flex;
  min-width: 0;
}

.record-actions van-button:first-child {
  flex: 1;
}

.record-actions van-button:last-child {
  flex: 2;
}

.clear-button,
.save-button {
  width: 100% !important;
  height: 80rpx !important;
  font-weight: 700 !important;
}

.save-button {
  font-size: 29rpx !important;
  box-shadow: 0 10rpx 26rpx var(--app-primary-glow) !important;
}
