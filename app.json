{
  "pages": [
    "pages/index/index",
    "pages/record/record",
    "pages/profile/profile"
  ],
  "window": {
    "navigationBarTitleText": "工时清单",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTextStyle",
    "backgroundColor": "@pageBgColor",
    "backgroundTextStyle": "@bgTextStyle"
  },
  "darkmode": true,
  "themeLocation": "theme.json",
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "总览",
        "iconPath": "assets/tab/overview.png",
        "selectedIconPath": "assets/tab/overview-active.png"
      },
      {
        "pagePath": "pages/record/record",
        "text": "填写",
        "iconPath": "assets/tab/record.png",
        "selectedIconPath": "assets/tab/record-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "管理",
        "iconPath": "assets/tab/manage.png",
        "selectedIconPath": "assets/tab/manage-active.png"
      }
    ]
  },
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json"
}
