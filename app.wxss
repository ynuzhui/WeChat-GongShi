page {
  min-height: 100vh;
  --primary-color: #167a61;
  --button-primary-background-color: #167a61;
  --button-primary-border-color: #167a61;
  --button-danger-background-color: #b13b2e;
  --button-danger-border-color: #b13b2e;
  --switch-on-background-color: #167a61;
  --switch-on-border-color: #167a61;
  --tag-primary-color: #167a61;
  --tag-success-color: #167a61;
  --tag-warning-color: #d97706;
  --tag-danger-color: #b13b2e;
  --cell-font-size: 28rpx;
  --cell-line-height: 40rpx;
  --field-label-color: #66766f;
  --app-bg: #f5f7f8;
  --app-card: #ffffff;
  --app-card-soft: #f9fbfa;
  --app-border: #dde8e3;
  --app-border-strong: #c8d8d1;
  --app-text: #17211d;
  --app-text-muted: #66766f;
  --app-text-soft: #8a9892;
  --app-primary: #167a61;
  --app-primary-soft: #e9f6f1;
  --app-warning: #d97706;
  --app-warning-soft: #fff4df;
  --app-danger: #b13b2e;
  --app-danger-soft: #fff0ed;
  --app-shadow: 0 14rpx 36rpx rgba(31, 55, 47, 0.07);
  background: var(--app-bg);
  color: var(--app-text);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(84rpx + env(safe-area-inset-bottom));
}

.tool-panel {
  border: 1rpx solid rgba(221, 232, 227, 0.92);
  border-radius: 12rpx;
  background: var(--app-card);
  box-shadow: var(--app-shadow);
}

.panel-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.panel-title {
  display: block;
  overflow: hidden;
  color: var(--app-text);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-note,
.panel-subtitle {
  display: block;
  overflow: hidden;
  margin-top: 6rpx;
  color: var(--app-text-muted);
  font-size: 23rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
